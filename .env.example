NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
WEB_ORIGIN=http://localhost:3002
PORT=4000
COOKIE_SECURE=false
# Set to none when web and API use different HTTPS origins.
COOKIE_SAME_SITE=lax
POSTGRES_DB=repocoach
POSTGRES_USER=repocoach
POSTGRES_PASSWORD=repocoach
POSTGRES_PORT=5432
# Used by the API container. Change it when deploying to a managed database.
DOCKER_DATABASE_URL=postgresql://repocoach:repocoach@postgres:5432/repocoach?schema=public
GITHUB_TOKEN=
# Optional: Node fetch will use this proxy for GitHub API calls.
HTTPS_PROXY=http://127.0.0.1:7897
# Optional Docker-only proxy; container localhost is not the Windows host.
CONTAINER_HTTPS_PROXY=http://host.docker.internal:7897
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=20000

# Set true in production to require a Gmail verification code after signup.
EMAIL_VERIFICATION_REQUIRED=false
# Gmail SMTP (required when EMAIL_VERIFICATION_REQUIRED=true in production)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=maomaotou5528@gmail.com
EMAIL_SMTP_PASS=
EMAIL_FROM=RepoCoach <maomaotou5528@gmail.com>

DATABASE_URL=postgresql://repocoach:repocoach@localhost:5432/repocoach?schema=public
